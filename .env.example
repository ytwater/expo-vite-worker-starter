# Since .env is gitignored, you can use this file to build a new `.env` when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# Auth secrets — also copy these into apps/workers-api/.dev.vars for local wrangler dev
# Generate AUTH_SECRET via: openssl rand -base64 32
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET='supersecret'

# Preconfigured Discord OAuth provider
# @see https://www.better-auth.com/docs/authentication/discord
AUTH_DISCORD_ID=''
AUTH_DISCORD_SECRET=''

# Optional: public Workers URL used for OAuth redirects in production
# AUTH_PRODUCTION_URL='https://diablo-4-character-scanner-api.your-subdomain.workers.dev'
