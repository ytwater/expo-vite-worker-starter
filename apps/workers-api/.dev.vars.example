# Secrets for local wrangler dev (copy to .dev.vars)
# Generate AUTH_SECRET with: openssl rand -base64 32

AUTH_SECRET=supersecret
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Optional: public production URL for OAuth redirects (defaults to request origin)
# AUTH_PRODUCTION_URL=https://diablo-4-character-scanner-api.your-subdomain.workers.dev
